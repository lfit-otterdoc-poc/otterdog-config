{
  "defaults": {
    "jsonnet": {
      "base_template": "https://github.com/eclipse-csi/otterdog#examples/template/otterdog-defaults.libsonnet@v1.4.0",
      "config_dir": "orgs"
    }
  },
  "organizations": [
    {
      "name": "lfit-otterdoc-poc",
      "github_id": "lfit-otterdoc-poc",
      "credentials": {
        "provider": "env",
        "api_token": "OTTER_API_TOKEN",
        "username": "OTTER_USERNAME",
        "password": "OTTER_PASSWORD",
        "twofa_seed": "OTTER_TWOFA_SEED"
      }
    }
  ]
}
